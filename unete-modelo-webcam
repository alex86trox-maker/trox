.btn-p{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;background:var(--wine);color:var(--cream);font-size:.68rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;border:none;cursor:pointer;border-radius:2px;transition:all .3s;position:relative;overflow:hidden}

.nav-cta{padding:9px 22px;border:1px solid rgba(185,128,143,.45);border-radius:2px;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;color:var(--rose-mid);background:transparent;cursor:pointer;text-decoration:none;transition:all .3s}

/* ═══ RESET & BASE ═══ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;font-size:16px;-webkit-overflow-scrolling:touch}
body{font-family:'Inter',sans-serif;background:#1e0014;color:#e8ddd5;overflow-x:hidden;line-height:1.6}
:root{
  --rose-light:#D5B1B8;
  --rose-mid:#B9808F;
  --rose-deep:#9D576F;
  --wine:#803655;
  --wine-dark:#641C40;
  --plum:#480A2E;
  --black:#1e0014;
  --surface:#2C001D;
  --surface-2:#380126;
  --cream:#e8ddd5;
  --muted:#b89fa8;
  --border:rgba(185,128,143,.18);
  --border-bright:rgba(185,128,143,.4);
  --serif:'Cormorant Garamond',serif;
  --ease:cubic-bezier(.4,0,.2,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-track{background:var(--black)}
::-webkit-scrollbar-thumb{background:var(--wine);border-radius:2px}

/* ═══ STATS STRIP ═══ */
.stats-strip{background:var(--surface-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:28px 24px}
.stats-inner{max-width:900px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;text-align:center}
.stat-item{}
.stat-num{font-family:var(--serif);font-size:2rem;font-weight:600;color:var(--rose-mid);display:block;line-height:1.1}
.stat-label{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-top:4px;display:block}
@media(max-width:640px){.stats-inner{grid-template-columns:repeat(2,1fr);gap:16px}}

/* ═══ INLINE CTA STRIP ═══ */
.inline-cta{background:linear-gradient(135deg,var(--wine-dark),var(--plum));padding:32px 24px;text-align:center;border-radius:12px;margin:48px auto 0;max-width:760px}
.inline-cta p{font-size:1.05rem;color:var(--cream);margin-bottom:16px;line-height:1.5}
